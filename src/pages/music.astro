---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { getRoomContent, getShelfSections } from '../lib/shelf';
import ShelfBoot from '../components/shelf/ShelfBoot.astro';
import Shelf from '../components/shelf/Shelf';

const INTRO = 'A few records I keep coming back to, and one song from each.';

const records = (await getCollection('records')).sort((a, b) => a.data.order - b.data.order);

// This page carries the room as an overlay, opened at the Console, the way
// /writing carries it opened at the Desk. Everything below is the Flat Site:
// the same records as ordinary links. See docs/adr/0005.
const sections = await getShelfSections();
const room = await getRoomContent();
---

<Base
  title="Music | Evan Greenhough"
  ogTitle="Music | Evan Greenhough"
  description={INTRO}
  path="/music"
>
  <ShelfBoot slot="head" />
  <Shelf slot="overlay" client:only="react" sections={sections} {...room} initialPlace="console" />

  <header class="page-head">
    <h1 class="page-title">Music</h1>
    <p class="page-intro">{INTRO}</p>
  </header>

  <section class="sec">
    <div class="post-list index">
      {
        records.map((record) => (
          <a
            class="post"
            href={`https://www.youtube.com/watch?v=${record.data.youtube}`}
            target="_blank"
            rel="noopener"
          >
            <h2 class="post-title">{record.data.song}</h2>
            <span class="post-date">YouTube &nearr;</span>
            <p class="post-excerpt">
              {record.data.artist}
              {record.data.album && <>, <em>{record.data.album}</em></>}
            </p>
          </a>
        ))
      }
    </div>
  </section>
</Base>
