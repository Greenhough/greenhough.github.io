---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';

const INTRO = 'Books I have read and would hand to someone else, three to a topic.';

const books = (await getCollection('books')).sort((a, b) => a.data.order - b.data.order);
// Topics in the order they first appear, each with its books.
const topics = [...new Set(books.map((b) => b.data.topic))].map((topic) => ({
  topic,
  books: books.filter((b) => b.data.topic === topic),
}));
---

<Base
  title="Books | Evan Greenhough"
  ogTitle="Books | Evan Greenhough"
  description={INTRO}
  path="/books"
>
  <header class="page-head">
    <h1 class="page-title">Books</h1>
    <p class="page-intro">{INTRO}</p>
  </header>

  {
    topics.map(({ topic, books }, i) => (
      <section class="sec shelf-row">
        <h2 class="row-title">{topic}</h2>
        <ul class="row">
          {books.map((book) => (
            <li class="book">
              <div class="frame">
              <img
                class="cover"
                src={`/assets/books/${book.id}.webp`}
                alt={`Cover of ${book.data.title} by ${book.data.author}`}
                width={book.data.cover.width}
                height={book.data.cover.height}
                loading={i < 2 ? 'eager' : 'lazy'}
                decoding="async"
              />
              </div>
              <h3 class="book-title">{book.data.title}</h3>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</Base>

<style>
  .shelf-row { margin-top: 0; }
  .row-title {
    font-family: 'JetBrains Mono', monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: .14em;
    text-transform: uppercase;
    margin: 0 0 18px;
  }
  .row {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 32px;
    max-width: 640px;
  }
  .book { min-width: 0; }
  /* Covers come in every shape. Each stands on the floor of one shared frame,
     uncropped, so the titles under them still line up across the row. */
  .frame {
    aspect-ratio: 2 / 3;
    display: flex;
    align-items: flex-end;
    justify-content: center;
  }
  .cover {
    display: block;
    width: auto;
    height: auto;
    max-width: 100%;
    max-height: 100%;
    border-radius: 3px;
    box-shadow: 0 1px 2px rgb(20 17 12 / .12), 0 8px 18px -8px rgb(20 17 12 / .35);
    background: #e9e5dc;
  }
  .book-title {
    font-family: 'Archivo', sans-serif;
    font-weight: 700;
    font-size: 15px;
    line-height: 1.3;
    margin: 12px 0 0;
  }
  @media (max-width: 560px) {
    .row { gap: 14px; }
    .book-title { font-size: 13px; }
  }
</style>
