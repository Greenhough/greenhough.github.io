---
interface Props {
  /** Article pages use the taller "spaced" footer. */
  spaced?: boolean;
}
const { spaced = false } = Astro.props;
---

<footer class:list={['footer', { spaced }]}>
  <span class="foot-name">Evan Greenhough</span>
  <span class="dot">&middot;</span>
  <a
    class="icon icon-li"
    href="https://www.linkedin.com/in/evangreenhough/"
    target="_blank"
    rel="noopener"
    aria-label="LinkedIn"
    ><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"
      ><path
        d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.2 8h4.6v14H.2V8zm7.4 0h4.4v1.9h.06c.61-1.16 2.1-2.38 4.34-2.38 4.64 0 5.5 3.05 5.5 7.02V22h-4.6v-6.2c0-1.48-.03-3.38-2.06-3.38-2.06 0-2.38 1.6-2.38 3.27V22H7.6V8z"
      ></path></svg
    ></a
  >
  <a class="icon icon-mail" href="mailto:evan.greenhough@gmail.com" aria-label="Email"
    ><svg
      width="19"
      height="19"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
      stroke-linecap="round"
      stroke-linejoin="round"
      ><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 7 9 6 9-6"></path></svg
    ></a
  >
</footer>
